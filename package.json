{
  "name": "captura-simples",
  "productName": "Captura Simples",
  "version": "1.3.0",
  "versaoBase": 3,
  "description": "Pré-visualização simples e de baixa latência para placas de captura USB",
  "main": "main.js",
  "author": "Hugo",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "test": "electron --no-sandbox scripts/teste.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "pt.hugo.capturasimples",
    "productName": "Captura Simples",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "ui/**/*",
      "icon.png",
      "package.json"
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Captura Simples",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "pt_PT"
      ],
      "language": "2070",
      "artifactName": "CapturaSimples-Setup.exe"
    }
  },
  "atualizacoes": {
    "repositorio": "opaxpk/captura-simples"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/opaxpk/captura-simples"
  }
}
